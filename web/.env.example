# Copy to web/.env and fill in. NEVER commit web/.env.

# Public base URL of the app (no trailing slash). For local dev keep localhost.
BASE_URL=http://localhost:8000

# --- Anthropic (API billing — this is what customers' classification costs) ---
# Create a key at https://platform.claude.com → API keys
ANTHROPIC_API_KEY=sk-ant-api03-...
# claude-haiku-4-5 = cheapest; bump to a bigger model only if quality demands it
MODEL=claude-haiku-4-5

# --- Google OAuth (Web application client) ---
# console.cloud.google.com → APIs & Services → Credentials → Create OAuth client
# → type "Web application" → authorized redirect URI: {BASE_URL}/oauth/callback
# Consent screen: External + Testing mode; add each tester under "Test users".
GOOGLE_CLIENT_ID=1234-....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- Stripe ---
# dashboard.stripe.com → Developers → API keys (start with test keys, sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret: `stripe listen --forward-to localhost:8000/stripe-webhook`
# for local dev, or Dashboard → Webhooks for production.
STRIPE_WEBHOOK_SECRET=whsec_...
PRICE_EUR_CENTS=500

# --- App secrets ---
# Generate: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Generate: .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Job limits ---
BACKFILL_DAYS=365
MAX_EMAILS_PER_JOB=10000
